# ══════════════════════════════════════════════════════════════════
#  TradeMarket AI — server/.env
#  NEVER commit this file. NEVER copy any of it into client/.
# ══════════════════════════════════════════════════════════════════

# ── runtime ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── auth ───────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Supabase / Postgres ────────────────────────────────────────────
# The service-role key CANNOT create tables (PostgREST has no DDL).
# For automatic table creation supply EITHER of these:
#   1) SUPABASE_DB_URL  – Project Settings → Database → Connection string (URI)
#   2) SUPABASE_ACCESS_TOKEN (sbp_...) + SUPABASE_PROJECT_REF (abcdefghijk)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ── Google Gemini (backend only — never expose to the client) ──────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── market data ────────────────────────────────────────────────────
# Simulated engine is always on and is the source of truth for fills.
# These adapters supply READ-ONLY quotes. They never place orders.
LIVE_CRYPTO=true
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# ── safety rails (do not weaken without understanding them) ────────
PAPER_TRADING_ONLY=true
MIN_SIM_DEPOSIT_INR=50
MAX_SIM_DEPOSIT_INR=1000000
MIN_USER_AGE=18
